{
  "manifest_version": 3,
  "name": "Resumely - AI Job Matcher & Application Assistant",
  "version": "1.0.0",
  "description": "1-Click save jobs to Resumely Tracker, analyze real-time ATS match score & keyword gaps, and autofill job applications instantly.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "dist/popup/index.html",
    "default_title": "Resumely Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/storage.js",
        "lib/matcher.js",
        "content-scripts/detector.js",
        "content-scripts/autofill.js",
        "content-scripts/widget.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "https://*.resumely.tech/*",
        "https://resumely.tech/*"
      ],
      "js": [
        "content-scripts/resumely-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}

